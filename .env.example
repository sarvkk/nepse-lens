# Copy to .env and fill in only what you need.
# Live NEPSE ingestion needs a short-lived "Salter" bearer token copied from
# the Authorization header of a market-data request in your browser's DevTools.
NEPSE_TOKEN=

# Optional overrides
NEPSE_BASE_URL=https://www.nepalstock.com.np
NEPSE_TIMEOUT=20
NEPSE_RATE_LIMIT=0.6
NEPSE_DB=data/nepse.duckdb
NEPSE_REPORTS_DIR=reports
